@online{prabhu2020LargeImageDatasets,
  title = {Large Image Datasets: {{A}} Pyrrhic Win for Computer Vision?},
  shorttitle = {Large Image Datasets},
  author = {Prabhu, Vinay Uday and Birhane, Abeba},
