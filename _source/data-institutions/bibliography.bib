@online{mazumder2023DataPerfBenchmarksDataCentric,
  title = {{{DataPerf}}: {{Benchmarks}} for {{Data-Centric AI Development}}},
  shorttitle = {{{DataPerf}}},
  author = {Mazumder, Mark and Banbury, Colby and Yao, Xiaozhe and Karlaš, Bojan and Rojas, William Gaviria and Diamos, Sudnya and Diamos, Greg and He, Lynn and Parrish, Alicia and Kirk, Hannah Rose and Quaye, Jessica and Rastogi, Charvi and Kiela, Douwe and Jurado, David and Kanter, David and Mosquera, Rafael and Ciro, Juan and Aroyo, Lora and Acun, Bilge and Chen, Lingjiao and Raje, Mehul Smriti and Bartolo, Max and Eyuboglu, Sabri and Ghorbani, Amirata and Goodman, Emmett and Inel, Oana and Kane, Tariq and Kirkpatrick, Christine R. and Kuo, Tzu-Sheng and Mueller, Jonas and Thrush, Tristan and Vanschoren, Joaquin and Warren, Margaret and Williams, Adina and Yeung, Serena and Ardalani, Newsha and Paritosh, Praveen and Bat-Leah, Lilith and Zhang, Ce and Zou, James and Wu, Carole-Jean and Coleman, Cody and Ng, Andrew and Mattson, Peter and Reddi, Vijay Janapa},
