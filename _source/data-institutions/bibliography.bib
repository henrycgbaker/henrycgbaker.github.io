  keywords = {Computer Science - Machine Learning},
  file = {C\:\\Users\\hbaker\\Zotero\\storage\\7KT6QI7F\\Mazumder et al. - 2023 - DataPerf Benchmarks for Data-Centric AI Developme.pdf;C\:\\Users\\hbaker\\Zotero\\storage\\AV3LE25K\\2207.html}
