@article{crawford2021ExcavatingAIPolitics,
  title = {Excavating {{AI}}: The Politics of Images in Machine Learning Training Sets},
  shorttitle = {Excavating {{AI}}},
  author = {Crawford, Kate and Paglen, Trevor},
  date = {2021-12-01},
  journaltitle = {AI \& SOCIETY},
  shortjournal = {AI \& Soc},
