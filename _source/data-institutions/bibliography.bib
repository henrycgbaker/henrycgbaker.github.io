  shorttitle = {Between {{Subjectivity}} and {{Imposition}}},
  author = {Miceli, Milagros and Schuessler, Martin and Yang, Tianling},
  date = {2020-10-15},
  journaltitle = {Proceedings of the ACM on Human-Computer Interaction},
